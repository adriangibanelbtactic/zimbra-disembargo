#!/usr/bin/env python3
"""Extract an upstream-ready source diff for two Zimbra release versions."""
import argparse
import importlib.machinery
import importlib.util
import re
import sys
from pathlib import Path
from types import ModuleType


def load_script(name: str, path: Path) -> ModuleType:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    specification = importlib.util.spec_from_loader(name, loader)
    if specification is None:
        raise RuntimeError(f"Could not load {path}")
    module = importlib.util.module_from_spec(specification)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


ROOT = Path(__file__).resolve().parent
MANUAL = load_script("ubuntu24_source_extract_manual", ROOT / "ubuntu24-source-extract-manual")
INSPECTOR = load_script("ubuntu24_deb_non_patch_package_inspect", ROOT / "ubuntu24-deb-non-patch-package-inspect")


def packages_for_release(packages: dict, package_name: str, release: str) -> list:
    """Return every catalogued Debian build for an X.Y.Z release label."""
    version_prefix = re.compile(rf"^{re.escape(release)}(?:[.-]|$)")
    candidates = [package for package in packages.get(package_name, []) if version_prefix.match(package.version)]
    if not candidates:
        raise MANUAL.ExtractionError(
            f"No catalogued {package_name} build begins with release {release}; run start to refresh APT metadata"
        )
    return candidates


def package_for_release(packages: dict, package_name: str, release: str):
    """Choose the newest catalogued Debian build for an X.Y.Z release label."""
    return packages_for_release(packages, package_name, release)[-1]


def package_predecessor(packages: list, package):
    """Return the immediately preceding catalogued build for one package."""
    earlier = [candidate for candidate in packages if INSPECTOR.compare_versions(candidate, package) < 0]
    if not earlier:
        raise MANUAL.ExtractionError(f"No catalogued predecessor exists for {package.name}={package.version}")
    return earlier[-1]


def package_comparisons(packages: dict, package_name: str, before_release: str, after_release: str) -> list[tuple]:
    """Build release-umbrella package comparisons for every after-release build.

    Each after build is compared with the newest build of the requested prior
    release (or the nearest earlier catalogued build if that release is gone).
    A second, incremental comparison is emitted when its immediate predecessor
    is a different build.  This preserves a cumulative diff applicable to the
    public source baseline while also retaining the exact package-build delta.
    """
    package_versions = packages.get(package_name, [])
    after_versions = packages_for_release(packages, package_name, after_release)
    try:
        baseline = package_for_release(packages, package_name, before_release)
    except MANUAL.ExtractionError:
        baseline = package_predecessor(package_versions, after_versions[0])

    comparisons: list[tuple] = []
    for after_package in after_versions:
        if INSPECTOR.compare_versions(baseline, after_package) >= 0:
            raise MANUAL.ExtractionError(
                f"Baseline package {baseline.version} must be lower than after package {after_package.version}"
            )
        comparisons.append((baseline, after_package))
        predecessor = package_predecessor(package_versions, after_package)
        if predecessor != baseline:
            comparisons.append((predecessor, after_package))
    return comparisons


def selected_releases(definition: dict, before_or_after: str, after_release: str | None, cache: Path) -> tuple[str, str]:
    """Use explicit releases, or find the previous existing upstream tag."""
    if after_release is not None:
        return before_or_after, after_release
    upstream = definition["upstream"]
    repository = MANUAL.ensure_repository(upstream["url"], cache / upstream["github_repository"].replace("/", "__"))
    before_release, _ = MANUAL.baseline_tag_for_release(repository, before_or_after)
    return before_release, before_or_after


def extract(
    extractor: str,
    before_or_after: str,
    after_release: str | None,
    definitions: Path,
    results: Path,
    cache: Path,
) -> list[Path]:
    definition_path = definitions / f"{extractor}.json"
    definition = MANUAL.load_definition(definition_path)
    before_release, after_release = selected_releases(definition, before_or_after, after_release, cache)
    package_names = {mapping["package"] for mapping in definition["mappings"]}
    if len(package_names) != 1:
        raise MANUAL.ExtractionError(
            f"Extractor {extractor} maps multiple packages; automatic extraction currently requires exactly one"
        )
    package_name = next(iter(package_names))
    catalogue = results / "zimbra-non-patch-debian-package-catalogue.json"
    packages = INSPECTOR.write_catalogue(catalogue)
    extracted: list[Path] = []
    comparisons = package_comparisons(
        packages, package_name, before_release, after_release
    )
    try:
        baseline_version = package_for_release(packages, package_name, before_release).version
    except MANUAL.ExtractionError:
        baseline_version = package_predecessor(
            packages[package_name], packages_for_release(packages, package_name, after_release)[0]
        ).version
    for before_package, after_package in comparisons:
        role = (
            "release-baseline"
            if before_package.version == baseline_version
            else "immediate-predecessor"
        )
        inspection, _ = INSPECTOR.compare(
            before_package, after_package, results / "deb-package-inspections", catalogue
        )
        extracted.append(
            MANUAL.extract(
                definition_path,
                after_release,
                inspection,
                results / "source-extractions",
                cache,
                before_tag=before_release,
                comparison_role=role,
            )
        )
    return extracted


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, usage="%(prog)s [options] <extractor> [<before-release>] <after-release>"
    )
    parser.add_argument("extractor", help="source extractor definition name, without .json")
    parser.add_argument("before_or_after", help="after release, or before release when AFTER is also supplied")
    parser.add_argument("after", nargs="?", help="optional after release, for example 10.1.20")
    parser.add_argument("--definitions-directory", type=Path, default=Path("/project/source-extractors"))
    parser.add_argument("--results-directory", type=Path, default=Path("/results"))
    parser.add_argument("--repository-cache", type=Path, default=Path("/work/source-extractor-repositories"))
    arguments = parser.parse_args()
    try:
        results = extract(
            arguments.extractor,
            arguments.before_or_after,
            arguments.after,
            arguments.definitions_directory,
            arguments.results_directory,
            arguments.repository_cache,
        )
    except (MANUAL.ExtractionError, INSPECTOR.AnalysisError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    for result in results:
        print(result / "upstream.diff")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
