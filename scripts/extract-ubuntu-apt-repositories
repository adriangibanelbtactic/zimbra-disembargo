#!/usr/bin/env python3
"""Safely render Ubuntu APT repository definitions from a Zimbra installer tgz.

The installer helper is intentionally not sourced: its configurePackageServer
function imports a GPG key, writes APT configuration, and executes apt-get.
This tool reads only the literal APT-source heredocs for a requested platform.
"""
import argparse
import hashlib
import json
import re
import sys
import tarfile
from pathlib import Path


FUNCTION_START = re.compile(r"^configurePackageServer\s*\(\)\s*\{")
FUNCTION_END = re.compile(r"^}\s*$")
HEREDOC_START = re.compile(
    r"^\s*cat\s+(?P<operator>>>|>)\s*"
    r"(?P<destination>/etc/apt/sources\.list\.d/[^\s]+)\s*<<\s*"
    r"(?P<delimiter>[A-Za-z_][A-Za-z0-9_]*)\s*$"
)
VARIABLE = re.compile(r"\$(?:\{(?P<braced>[A-Za-z_][A-Za-z0-9_]*)\}|(?P<plain>[A-Za-z_][A-Za-z0-9_]*))")
PLATFORM_CONDITION = re.compile(r"\$PLATFORM\s*=\s*\"(?P<platform>UBUNTU[0-9]+_64)\"")


def configure_package_server_lines(source: str) -> list[str]:
    """Return the function body, failing when the expected structure changes."""
    lines = source.splitlines()
    start = next((index for index, line in enumerate(lines) if FUNCTION_START.match(line)), None)
    if start is None:
        raise ValueError("configurePackageServer function was not found")
    end = next((index for index in range(start + 1, len(lines)) if FUNCTION_END.match(lines[index])), None)
    if end is None:
        raise ValueError("configurePackageServer function has no closing brace")
    return lines[start + 1 : end]


def condition_matches(line: str, platform: str, include_network: bool) -> bool:
    """Evaluate only the installer condition forms relevant to source heredocs."""
    platform_match = PLATFORM_CONDITION.search(line)
    if platform_match:
        return platform_match.group("platform") == platform
    if "ZMTYPE_INSTALLABLE" in line and "NETWORK" in line:
        return include_network
    # Other guards select the Debian-family branch or perform installer setup.
    # They do not distinguish the Ubuntu source heredocs we render.
    return True


def apt_heredocs(lines: list[str], platform: str, include_network: bool) -> dict[str, str]:
    """Collect active literal APT-source heredocs without executing shell code."""
    files: dict[str, str] = {}
    conditions: list[dict[str, bool]] = []
    index = 0
    while index < len(lines):
        line = lines[index]
        stripped = line.strip()
        if re.match(r"^(?:if|elif)\b", stripped):
            matches = condition_matches(line, platform, include_network)
            if stripped.startswith("if"):
                parent_active = all(frame["active"] for frame in conditions)
                conditions.append({"parent_active": parent_active, "matched": matches, "active": parent_active and matches})
            else:
                if not conditions:
                    raise ValueError("unexpected elif while reading configurePackageServer")
                frame = conditions[-1]
                frame["active"] = frame["parent_active"] and not frame["matched"] and matches
                frame["matched"] = frame["matched"] or matches
            index += 1
            continue
        if stripped == "else":
            if not conditions:
                raise ValueError("unexpected else while reading configurePackageServer")
            frame = conditions[-1]
            frame["active"] = frame["parent_active"] and not frame["matched"]
            frame["matched"] = True
            index += 1
            continue
        if stripped == "fi":
            if not conditions:
                raise ValueError("unexpected fi while reading configurePackageServer")
            conditions.pop()
            index += 1
            continue

        match = HEREDOC_START.match(line)
        if not match:
            index += 1
            continue
        delimiter = match.group("delimiter")
        body_start = index + 1
        body_end = next((candidate for candidate in range(body_start, len(lines)) if lines[candidate] == delimiter), None)
        if body_end is None:
            raise ValueError(f"unterminated heredoc for {match.group('destination')}")
        if all(frame["active"] for frame in conditions):
            destination = match.group("destination")
            body = "\n".join(lines[body_start:body_end]) + "\n"
            files[destination] = body if match.group("operator") == ">" else files.get(destination, "") + body
        index = body_end + 1
    return files


def ubuntu_repository_names(lines: list[str]) -> dict[str, str]:
    """Read the source's explicit Ubuntu platform-to-suite mapping."""
    result: dict[str, str] = {}
    for index, line in enumerate(lines):
        match = PLATFORM_CONDITION.search(line)
        if not match:
            continue
        for candidate in lines[index + 1 : index + 4]:
            repository = re.match(r'^\s*repo="(?P<repo>[^"]+)"\s*$', candidate)
            if repository:
                result[match.group("platform")] = repository.group("repo")
                break
    return result


def substitute(template: str, values: dict[str, str]) -> str:
    def replacement(match: re.Match[str]) -> str:
        name = match.group("braced") or match.group("plain")
        if name not in values:
            raise ValueError(f"unsupported variable ${name} in APT source heredoc")
        return values[name]

    return VARIABLE.sub(replacement, template)


def apt_sources(files: dict[str, str], values: dict[str, str]) -> list[dict[str, object]]:
    repositories: list[dict[str, object]] = []
    for source_path, template in files.items():
        for stanza in substitute(template, values).strip().split("\n\n"):
            fields: dict[str, str] = {}
            for line in stanza.splitlines():
                key, separator, value = line.partition(":")
                if not separator:
                    raise ValueError(f"invalid deb822 line in {source_path}: {line!r}")
                fields[key.lower()] = value.strip()
            required = ("types", "uris", "suites", "components", "architectures", "signed-by")
            missing = [field for field in required if field not in fields]
            if missing:
                raise ValueError(f"APT source stanza in {source_path} lacks: {', '.join(missing)}")
            repositories.append(
                {
                    "types": fields["types"].split(),
                    "uri": fields["uris"],
                    "suite": fields["suites"],
                    "component": fields["components"],
                    "architectures": fields["architectures"].split(),
                    "signed_by": fields["signed-by"],
                    "source_file": source_path,
                }
            )
    return repositories


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_installer_helper(archive: Path) -> tuple[str, bytes]:
    if archive.suffix != ".tgz":
        raise ValueError(f"installer archive must have a .tgz suffix: {archive}")
    archive_base = archive.name[: -len(".tgz")]
    member_name = f"{archive_base}/util/utilfunc.sh"
    with tarfile.open(archive, "r:gz") as tar:
        member = tar.getmember(member_name)
        member_file = tar.extractfile(member)
        if member_file is None:
            raise ValueError(f"archive member is not a regular file: {member_name}")
        return member_name, member_file.read()


def write_repository_files(files: dict[str, str], values: dict[str, str], output_directory: Path) -> list[str]:
    output_directory.mkdir(parents=True, exist_ok=True)
    written: list[str] = []
    for source_path, template in files.items():
        destination = output_directory / Path(source_path).name
        destination.write_text(substitute(template, values), encoding="utf-8")
        written.append(str(destination))
    return written


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("installer_tgz", type=Path, help="Zimbra installer .tgz input")
    parser.add_argument("--platform", default="UBUNTU24_64", help="Ubuntu platform identifier (default: UBUNTU24_64)")
    parser.add_argument("--edition", choices=("network", "foss"), default="network", help="installer edition (default: network)")
    parser.add_argument("--package-server", help="override PACKAGE_SERVER; default is the helper's production default")
    parser.add_argument("--output-directory", type=Path, default=Path("apt.sources.d"), help="directory for rendered .sources files")
    parser.add_argument("--report", type=Path, help="write provenance JSON to this path (default: no report file)")
    arguments = parser.parse_args()

    if not arguments.platform.startswith("UBUNTU"):
        parser.error("only Ubuntu platforms are supported")
    member_name, source_bytes = read_installer_helper(arguments.installer_tgz)
    lines = configure_package_server_lines(source_bytes.decode("utf-8"))
    default_server = next(
        (line.split("=", 1)[1].strip().strip('"') for line in lines if line.strip().startswith("TMP_PACKAGE_SERVER=")),
        None,
    )
    if not default_server:
        raise ValueError("TMP_PACKAGE_SERVER assignment was not found")
    values = {"PACKAGE_SERVER": arguments.package_server or default_server, "repo": ""}
    platform_repositories = ubuntu_repository_names(lines)
    if arguments.platform not in platform_repositories:
        parser.error(f"platform {arguments.platform} has no Ubuntu repository mapping in {arguments.installer_tgz}")
    values["repo"] = platform_repositories[arguments.platform]
    files = apt_heredocs(lines, arguments.platform, arguments.edition == "network")
    if not files:
        parser.error(f"no APT repository heredocs were found for {arguments.platform}")
    rendered_repositories = apt_sources(files, values)
    written_files = write_repository_files(files, values, arguments.output_directory)
    report = {
        "schema_version": 1,
        "method": "static-installer-repository-extraction",
        "input": {
            "archive_path": str(arguments.installer_tgz),
            "archive_sha256": sha256_file(arguments.installer_tgz),
            "installer_helper_member": member_name,
            "installer_helper_sha256": hashlib.sha256(source_bytes).hexdigest(),
        },
        "assumptions": {
            "platform": arguments.platform,
            "edition": arguments.edition,
            "use_zimbra_package_server": True,
            "package_server": values["PACKAGE_SERVER"],
            "suite": values["repo"],
        },
        "repositories": rendered_repositories,
        "rendered_files": written_files,
    }
    if arguments.report:
        arguments.report.parent.mkdir(parents=True, exist_ok=True)
        arguments.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(f"Rendered {len(written_files)} APT source file(s) in {arguments.output_directory}")
    if arguments.report:
        print(f"Wrote provenance report to {arguments.report}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, UnicodeDecodeError, tarfile.TarError) as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(2)
