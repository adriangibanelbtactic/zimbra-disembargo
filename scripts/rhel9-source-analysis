#!/usr/bin/env bash
# Manage the disposable Rocky Linux 9 environment used to investigate RHEL
# source packages.
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
readonly IMAGE='zimbra-disembargo-rhel9-source-analysis'
readonly CONTAINER='zimbra-disembargo-rhel9-source-analysis'
readonly WORK_DIR="${ZIMBRA_ANALYSIS_WORK:-${REPOSITORY_DIR}/var/rhel9-source-analysis}"

usage() {
    cat <<'EOF'
Usage: scripts/rhel9-source-analysis <command>

Commands:
  build   Build the Rocky Linux 9 analysis image for the invoking user.
  start   Start the named analysis container (builds the image when needed).
  shell   Open an interactive shell in the running analysis container.
  srpm-diff <package> [--after <EVR>]
          Compare the latest, or a selected, public SRPM with its predecessor.
  srpm-diff --interactive
          Select a package and two public SRPM versions in a terminal UI.
  status  Show the named container's state.
  stop    Stop and remove the named analysis container; retain host data.

Environment:
  ZIMBRA_ANALYSIS_WORK  Writable host directory mounted at /work.
                          Default: var/rhel9-source-analysis inside this checkout
EOF
}

build() {
    docker build \
        --build-arg "ZIMBRA_DISEMBARGOER_UID=$(id -u)" \
        --build-arg "ZIMBRA_DISEMBARGOER_GID=$(id -g)" \
        --tag "${IMAGE}" \
        --file "${REPOSITORY_DIR}/Dockerfiles/rhel9-source-analysis/Dockerfile" \
        "${REPOSITORY_DIR}"
}

start() {
    if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
        build
    fi
    if docker container inspect "${CONTAINER}" >/dev/null 2>&1; then
        if [[ "$(docker container inspect --format '{{.State.Running}}' "${CONTAINER}")" == 'true' ]]; then
            printf 'Container already running: %s\n' "${CONTAINER}"
        else
            docker start "${CONTAINER}" >/dev/null
            printf 'Container started: %s\n' "${CONTAINER}"
        fi
        return
    fi

    mkdir -p -- "${WORK_DIR}/results"
    docker run --detach --init --name "${CONTAINER}" \
        --mount "type=bind,src=${REPOSITORY_DIR},dst=/project,readonly" \
        --mount "type=bind,src=${WORK_DIR},dst=/work" \
        --mount "type=bind,src=${WORK_DIR}/results,dst=/results" \
        "${IMAGE}" sleep infinity >/dev/null
    printf 'Container started: %s\n' "${CONTAINER}"
}

shell() {
    docker exec --interactive --tty "${CONTAINER}" bash -l
}

srpm_diff() {
    docker exec --interactive --tty "${CONTAINER}" \
        /project/scripts/rhel9-srpm-diff "$@"
}

status() {
    docker container inspect --format \
        '{{.Name}}: running={{.State.Running}} image={{.Config.Image}}' \
        "${CONTAINER}"
}

stop() {
    docker rm --force "${CONTAINER}"
}

command=${1:-}
if [[ $# -gt 0 ]]; then
    shift
fi

case "${command}" in
    build) build ;;
    start) start ;;
    shell) shell ;;
    srpm-diff) srpm_diff "$@" ;;
    status) status ;;
    stop) stop ;;
    *) usage; exit 2 ;;
esac
