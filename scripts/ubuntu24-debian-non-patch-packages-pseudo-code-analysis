#!/usr/bin/env bash
# Manage the disposable Ubuntu 24.04 environment used to inspect non-patch
# Zimbra Network Edition Debian packages.
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
readonly IMAGE='zimbra-disembargo-ubuntu24-debian-non-patch-packages-pseudo-code-analysis'
readonly CONTAINER='zimbra-disembargo-ubuntu24-debian-non-patch-packages-pseudo-code-analysis'
readonly WORK_DIR="${REPOSITORY_DIR}/var/ubuntu24-debian-non-patch-packages-pseudo-code-analysis"

usage() {
    cat <<'EOF'
Usage: scripts/ubuntu24-debian-non-patch-packages-pseudo-code-analysis <command> [--ubuntu-series 18|20|22|24]

Commands:
  build    Build the Ubuntu 24.04 analysis image for the invoking user.
  start    Start the named Ubuntu 24.04 analysis container (builds the image when needed).
  shell    Open an interactive shell after selecting its APT repository series.
  catalog
            Record non-patch packages from the selected Zimbra Ubuntu APT repositories.
  catalog-availability
            Catalogue Ubuntu 18, 20, 22, and 24 repositories and merge their version map.
  deb-inspect [package] [--after <version>] [--refresh-catalog]
           Compare all regular payload files in a package's latest two versions.
  deb-inspect --interactive
           Select a catalogued non-patch package and two repository versions.
  source-extract <extractor> <before-release> <after-release>
            Download the selected-series package builds and print an upstream-ready diff.
  source-extract-manual <extractor> --tag <upstream-tag> --inspection-directory <path>
            Inspect an existing package comparison and report artifact hunks.
  status   Show the named container's state.
  stop     Stop and remove the named analysis container; retain host data.

EOF
}

ubuntu_series=24
arguments=()

parse_ubuntu_series() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ubuntu-series)
                [[ $# -ge 2 ]] || { printf '%s\n' 'error: --ubuntu-series requires 18, 20, 22, or 24' >&2; exit 2; }
                ubuntu_series=$2
                shift 2
                ;;
            --ubuntu-series=*)
                ubuntu_series=${1#--ubuntu-series=}
                shift
                ;;
            *)
                arguments+=("$1")
                shift
                ;;
        esac
    done
    case "$ubuntu_series" in
        18|20|22|24) ;;
        *) printf 'error: unsupported Ubuntu repository series: %s (expected 18, 20, 22, or 24)\n' "$ubuntu_series" >&2; exit 2 ;;
    esac
}

build() {
    docker build \
        --build-arg "ZIMBRA_DISEMBARGOER_UID=$(id -u)" \
        --build-arg "ZIMBRA_DISEMBARGOER_GID=$(id -g)" \
        --tag "${IMAGE}" \
        --file "${REPOSITORY_DIR}/Dockerfiles/ubuntu24-debian-non-patch-packages-pseudo-code-analysis/Dockerfile" \
        "${REPOSITORY_DIR}"
}

start() {
    if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
        build
    fi
    if docker container inspect "${CONTAINER}" >/dev/null 2>&1; then
        if [[ "$(docker container inspect --format '{{.State.Running}}' "${CONTAINER}")" == 'true' ]]; then
            printf 'Container already running: %s\n' "${CONTAINER}"
        else
            docker start "${CONTAINER}" >/dev/null
            printf 'Container started: %s\n' "${CONTAINER}"
        fi
    else
        mkdir -p -- "${WORK_DIR}/results"
        docker run --detach --init --name "${CONTAINER}" \
            --mount "type=bind,src=${REPOSITORY_DIR},dst=/project,readonly" \
            --mount "type=bind,src=${WORK_DIR},dst=/work" \
            --mount "type=bind,src=${WORK_DIR}/results,dst=/results" \
            "${IMAGE}" sleep infinity >/dev/null
        printf 'Container started: %s\n' "${CONTAINER}"
    fi
    select_ubuntu_series "$ubuntu_series"
}

select_ubuntu_series() {
    local series=$1
    docker exec --user root "${CONTAINER}" bash -ceu '
        series=$1
        profile="/project/Dockerfiles/repositories/debian-repos/ubuntu${series}"
        test -d "$profile"
        shopt -s nullglob
        sources=("$profile"/*.list)
        test "${#sources[@]}" -gt 0
        rm -f /etc/apt/sources.list.d/zimbra.list /etc/apt/sources.list.d/zimbra-onlyoffice.list
        rm -f /var/lib/apt/lists/repo.zimbra.com_apt_*
        cp "${sources[@]}" /etc/apt/sources.list.d/
        apt-get update
    ' -- "$series"
}

shell() {
    docker exec --interactive --tty "${CONTAINER}" bash -l
}

inspect() {
    if [[ -t 0 && -t 1 ]]; then
        docker exec --interactive --tty "${CONTAINER}" /project/scripts/ubuntu24-deb-non-patch-package-inspect "$@"
    else
        docker exec "${CONTAINER}" /project/scripts/ubuntu24-deb-non-patch-package-inspect "$@"
    fi
}

inspect_source() {
    if [[ -t 0 && -t 1 ]]; then
        docker exec --interactive --tty "${CONTAINER}" /project/scripts/ubuntu24-source-extract "$@"
    else
        docker exec "${CONTAINER}" /project/scripts/ubuntu24-source-extract "$@"
    fi
}

inspect_source_manual() {
    if [[ -t 0 && -t 1 ]]; then
        docker exec --interactive --tty "${CONTAINER}" /project/scripts/ubuntu24-source-extract-manual "$@"
    else
        docker exec "${CONTAINER}" /project/scripts/ubuntu24-source-extract-manual "$@"
    fi
}

series_results_root() {
    if [[ "$ubuntu_series" == 24 ]]; then
        printf '%s' /results
    else
        printf '/results/ubuntu%s' "$ubuntu_series"
    fi
}

prepare_series() {
    select_ubuntu_series "$ubuntu_series"
}

catalog() {
    prepare_series
    local root
    root=$(series_results_root)
    inspect --catalog --catalogue-file "$root/zimbra-non-patch-debian-package-catalogue.json" "${arguments[@]}"
}

deb_inspect() {
    prepare_series
    local root
    root=$(series_results_root)
    inspect \
        --catalogue-file "$root/zimbra-non-patch-debian-package-catalogue.json" \
        --results-directory "$root/deb-package-inspections" \
        "${arguments[@]}"
}

source_extract() {
    prepare_series
    local root
    root=$(series_results_root)
    inspect_source \
        --results-directory "$root" \
        --repository-cache "/work/source-extractor-repositories/ubuntu${ubuntu_series}" \
        "${arguments[@]}"
}

catalog_availability() {
    local series root catalogue_arguments=()
    [[ ${#arguments[@]} -eq 0 ]] || { printf '%s\n' 'error: catalog-availability does not accept additional arguments' >&2; exit 2; }
    for series in 18 20 22 24; do
        ubuntu_series=$series
        prepare_series
        root=$(series_results_root)
        inspect --catalog --catalogue-file "$root/zimbra-non-patch-debian-package-catalogue.json"
        catalogue_arguments+=(--catalogue "${series}=${root}/zimbra-non-patch-debian-package-catalogue.json")
    done
    docker exec "${CONTAINER}" /project/scripts/ubuntu-package-repository-map \
        "${catalogue_arguments[@]}" \
        --output /results/ubuntu-repository-version-map.json
    ubuntu_series=24
    prepare_series
}

status() {
    docker container inspect --format '{{.Name}}: running={{.State.Running}} image={{.Config.Image}}' "${CONTAINER}"
}

stop() {
    docker rm --force "${CONTAINER}"
}

command=${1:-}
if [[ $# -gt 0 ]]; then
    shift
fi
parse_ubuntu_series "$@"
case "${command}" in
    build) build ;;
    start) start ;;
    shell) prepare_series; shell ;;
    catalog) catalog ;;
    catalog-availability) catalog_availability ;;
    deb-inspect) deb_inspect ;;
    source-extract) source_extract ;;
    source-extract-manual) inspect_source_manual "${arguments[@]}" ;;
    status) status ;;
    stop) stop ;;
    *) usage; exit 2 ;;
esac
