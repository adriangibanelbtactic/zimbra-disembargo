{
  "schema_version": 1,
  "name": "zm-ajax",
  "upstream": {
    "github_repository": "Zimbra/zm-ajax",
    "url": "https://github.com/Zimbra/zm-ajax.git"
  },
  "artifact-positive": [
    "opt/zimbra/jetty_base/webapps/zimbra/js/Ajax_all.js"
  ],
  "filter-positive": [
    ".js"
  ],
  "filter-negative": [
    ".jar",
    ".class",
    ".java",
    "ZaMsg*properties",
    "ZsMsg*properties",
    ".zgz"
  ],
  "mappings": [
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/js/Ajax_all.js",
      "derivation": {
        "type": "ajx-package-bundle",
        "manifest": "WebRoot/js/ajax/package/Ajax.js"
      },
      "source-roots": [
        "WebRoot/js/ajax"
      ],
      "source-suffixes": [
        ".js"
      ]
    }
  ]
}
