{
  "schema_version": 1,
  "name": "zm-admin-console",
  "upstream": {
    "github_repository": "Zimbra/zm-admin-console",
    "url": "https://github.com/Zimbra/zm-admin-console.git"
  },
  "artifact-positive": [
    "opt/zimbra/jetty_base/webapps/zimbraAdmin/js/Admin_all.js",
    "opt/zimbra/jetty_base/webapps/zimbraAdmin/WEB-INF/web.xml"
  ],
  "filter-positive": [
    ".js",
    ".xml"
  ],
  "filter-negative": [
    ".jar",
    ".class",
    ".java",
    "AjxMsg*properties",
    "ZaMsg*properties",
    "ZhMsg*properties",
    "ZmMsg*properties",
    "ZsMsg*properties",
    ".zgz"
  ],
  "mappings": [
    {
      "package": "zimbra-mbox-admin-console-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbraAdmin/WEB-INF/web.xml",
      "source-roots": [
        "WebRoot/WEB-INF"
      ],
      "source-suffixes": [
        ".xml"
      ]
    },
    {
      "package": "zimbra-mbox-admin-console-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbraAdmin/js/Admin_all.js",
      "derivation": {
        "type": "ajx-package-bundle",
        "manifest": "WebRoot/js/zimbraAdmin/package/Admin.js"
      },
      "source-roots": [
        "WebRoot/js/zimbraAdmin"
      ],
      "source-suffixes": [
        ".js"
      ]
    }
  ]
}
