{
  "schema_version": 1,
  "name": "zm-web-client",
  "upstream": {
    "github_repository": "Zimbra/zm-web-client",
    "url": "https://github.com/Zimbra/zm-web-client.git"
  },
  "artifact-positive": [
    "opt/zimbra/jetty_base/webapps/zimbra/WEB-INF/tags/rest/restHead.tag",
    "opt/zimbra/jetty_base/webapps/zimbra/public/launchNewWindow.jsp",
    "opt/zimbra/jetty_base/webapps/zimbra/public/launchZCS.jsp",
    "opt/zimbra/jetty_base/webapps/zimbra/h/changepass",
    "opt/zimbra/jetty_base/webapps/zimbra/public/login.jsp",
    "opt/zimbra/jetty_base/webapps/zimbra/js/Mail_all.js",
    "opt/zimbra/jetty_base/webapps/zimbra/js/zimbraMail/mail/view/ZmInviteMsgView.js",
    "opt/zimbra/conf/templates/mail/Message.template",
    "opt/zimbra/jetty_base/webapps/zimbra/WEB-INF/tags/rest/restDocument.tag",
    "opt/zimbra/jetty_base/webapps/zimbra/WEB-INF/tags/rest/restDocumentPreview.tag",
    "opt/zimbra/jetty_base/webapps/zimbra/WEB-INF/tags/rest/restDocumentView.tag",
    "opt/zimbra/jetty_base/webapps/zimbra/public/Resources.jsp"
  ],
  "filter-positive": [
    ".jsp",
    ".tag",
    ".js",
    ".template",
    "changepass"
  ],
  "filter-negative": [
    ".jar",
    ".class",
    ".java",
    "ZaMsg*properties",
    "ZsMsg*properties",
    ".zgz"
  ],
  "mappings": [
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact-root": "opt/zimbra/jetty_base/webapps/zimbra/WEB-INF/tags/rest",
      "source-root": "WebRoot/WEB-INF/tags/rest"
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/public/launchNewWindow.jsp",
      "source-roots": [
        "WebRoot/public"
      ],
      "source-suffixes": [
        ".jsp"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/public/launchZCS.jsp",
      "source-roots": [
        "WebRoot/public"
      ],
      "source-suffixes": [
        ".jsp"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/h/changepass",
      "source-roots": [
        "WebRoot/h"
      ],
      "source-suffixes": [
        "changepass"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/public/login.jsp",
      "source-roots": [
        "WebRoot/public"
      ],
      "source-suffixes": [
        ".jsp"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/js/Mail_all.js",
      "derivation": {
        "type": "ajx-package-bundle",
        "manifest": "WebRoot/js/zimbraMail/package/Mail.js"
      },
      "source-roots": [
        "WebRoot/js/zimbraMail"
      ],
      "source-suffixes": [
        ".js"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/js/zimbraMail/mail/view/ZmInviteMsgView.js",
      "source-roots": [
        "WebRoot/js/zimbraMail/mail/view"
      ],
      "source-suffixes": [
        ".js"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/conf/templates/mail/Message.template",
      "source-roots": [
        "WebRoot/templates/mail"
      ],
      "source-suffixes": [
        ".template"
      ]
    },
    {
      "package": "zimbra-mbox-webclient-war",
      "artifact": "opt/zimbra/jetty_base/webapps/zimbra/public/Resources.jsp",
      "source-roots": [
        "WebRoot/public/Resources.jsp"
      ],
      "source-suffixes": [
        ".jsp"
      ]
    }
  ]
}
