#!/usr/bin/env bash
# Survey public Zimbra repositories at a target tag and their nearest baselines.
set -euo pipefail

readonly TOOL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPOSITORY_DIR="$(cd -- "${TOOL_DIR}/../.." && pwd)"
readonly PRINT_REPOSITORIES="${TOOL_DIR}/print-zimbra-build-repositories"

usage() {
    cat <<'EOF'
Usage: survey-zimbra-upstream-tags [--cache-directory DIRECTORY] [--output-directory DIRECTORY] <before-tag> <after-tag>

Use zm-build-print-repos.pl for the target zm-build tag. For every selected
repository that exposes the target component tag, find the nearest lower
X.Y.Z component tag in the same release series, stopping at X.Y.0. For each
repository with a target and baseline tag, record commit messages and changed
paths.

The report directory receives repositories-target.txt, tag-status.tsv, and
changes/<repository>/{log,names}. tag-status.tsv records the baseline selected
per repository, which need not be the requested before tag.
EOF
}

cache_directory="${REPOSITORY_DIR}/cache/release-security-extractor-review"
output_directory=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --cache-directory)
            cache_directory="$2"
            shift 2
            ;;
        --output-directory)
            output_directory="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            usage >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -ne 2 ]]; then
    usage >&2
    exit 2
fi
before_tag="$1"
after_tag="$2"
if [[ ! "$after_tag" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf 'error: target tag must be a numeric X.Y.Z release: %s\n' "$after_tag" >&2
    exit 2
fi
target_major="${BASH_REMATCH[1]}"
target_minor="${BASH_REMATCH[2]}"
target_patch="${BASH_REMATCH[3]}"
if (( 10#$target_patch == 0 )); then
    printf 'error: target tag has no lower X.Y.Z baseline: %s\n' "$after_tag" >&2
    exit 2
fi
if [[ -z "$output_directory" ]]; then
    output_directory="${cache_directory}/surveys/${before_tag}__to__${after_tag}"
fi
if [[ -e "$output_directory" ]]; then
    printf 'error: report directory already exists: %s\n' "$output_directory" >&2
    exit 1
fi

mkdir -p -- "$output_directory/changes"
"$PRINT_REPOSITORIES" --cache-directory "$cache_directory" "$after_tag" | sort -u > "${output_directory}/repositories-target.txt"
baseline_candidates=()
for ((patch = 10#$target_patch - 1; patch >= 0; patch--)); do
    baseline_candidates+=("${target_major}.${target_minor}.${patch}")
done

has_tag() {
    local refs=$1 tag=$2
    awk -v tag="refs/tags/${tag}" '$2 == tag || $2 == tag "^{}" { found=1 } END { exit !found }' <<<"$refs"
}

printf 'repository\turl\tlisted_at_target\thas_target_tag\tselected_baseline_tag\thas_baseline_tag\n' > "${output_directory}/tag-status.tsv"
while IFS= read -r url; do
    repository="${url##*/}"
    repository="${repository%.git}"
    refs="$(git ls-remote --tags "$url" "refs/tags/${after_tag}" "refs/tags/${target_major}.${target_minor}.*" 2>/dev/null || true)"
    has_after='no'
    selected_baseline=''
    has_baseline='no'
    if has_tag "$refs" "$after_tag"; then
        has_after='yes'
        for candidate in "${baseline_candidates[@]}"; do
            if has_tag "$refs" "$candidate"; then
                selected_baseline=$candidate
                has_baseline='yes'
                break
            fi
        done
    fi
    printf '%s\t%s\tyes\t%s\t%s\t%s\n' "$repository" "$url" "$has_after" "$selected_baseline" "$has_baseline" >> "${output_directory}/tag-status.tsv"
done < "${output_directory}/repositories-target.txt"

upstream_cache="${cache_directory}/upstream-repositories"
mkdir -p -- "$upstream_cache"
tail --lines=+2 "${output_directory}/tag-status.tsv" | while IFS=$'\t' read -r repository url listed_at_target has_after selected_baseline has_baseline; do
    if [[ "$has_after" != yes || "$has_baseline" != yes ]]; then
        continue
    fi
    repository_cache="${upstream_cache}/${repository}"
    if [[ -d "${repository_cache}/.git" ]]; then
        git -C "$repository_cache" remote set-url origin "$url"
        git -C "$repository_cache" fetch --quiet --force --tags origin
    elif [[ -e "$repository_cache" ]]; then
        printf 'error: upstream cache is not a Git checkout: %s\n' "$repository_cache" >&2
        exit 1
    else
        git clone --quiet --filter=blob:none --no-checkout "$url" "$repository_cache"
    fi
    repository_output="${output_directory}/changes/${repository}"
    mkdir -- "$repository_output"
    git -C "$repository_cache" log --format='%H%x09%s' "${selected_baseline}..${after_tag}" > "${repository_output}/log.tsv"
    git -C "$repository_cache" diff --name-status --no-renames "$selected_baseline" "$after_tag" > "${repository_output}/names.tsv"
done

printf '%s\n' "$output_directory"
